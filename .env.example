# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN AUTHENTICATION
# Bcrypt hash of your admin password (e.g. generated via bcrypt.hashSync('mySecretPassword', 10))
ADMIN_PASSWORD_HASH=

# Secret key used to sign JWT admin session tokens
ADMIN_SESSION_SECRET=

# GITHUB INTEGRATION (Optional - automatically commits project updates to GitHub repo)
# Personal Access Token (classic with repo scope, or fine-grained with Contents read/write)
GITHUB_TOKEN=

# Repository owner (username or organization)
GITHUB_OWNER=

# Repository name
GITHUB_REPO=

# Default branch (e.g. main or master)
GITHUB_BRANCH=main
